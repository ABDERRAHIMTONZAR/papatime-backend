generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())

  equipe    Equipe?  @relation(fields: [equipeId], references: [id])
  equipeId  Int?

  projets             Projet[]
  timeEntries         TimeEntry[]
  taches              Tache[]      @relation("AssignedTasks")
  invitationsCreated  Invitation[] @relation("InvitationCreator")
  invitationUsed      Invitation?  @relation("InvitationUser")
}

model Equipe {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  members     User[]
  projets     Projet[]
  invitations Invitation[]
  taches      Tache[] 
}

model Invitation {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  role      Role      @default(EMPLOYEE)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  equipe      Equipe   @relation(fields: [equipeId], references: [id])
  equipeId    Int

  createdBy   User     @relation("InvitationCreator", fields: [createdById], references: [id])
  createdById Int

  usedBy      User?    @relation("InvitationUser", fields: [usedById], references: [id])
  usedById    Int?     @unique
}

model Projet {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  createdBy   User     @relation(fields: [userId], references: [id])
  userId      Int

  equipe      Equipe?  @relation(fields: [equipeId], references: [id])
  equipeId    Int?

  taches      Tache[]
  timeEntries TimeEntry[]
}

model Tache {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projet      Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId    Int

  assignedTo  User?    @relation("AssignedTasks", fields: [assignedId], references: [id])
  assignedId  Int?

  equipe      Equipe?  @relation(fields: [equipeId], references: [id])
  equipeId    Int?

  timeEntries TimeEntry[]
}

model TimeEntry {
  id          Int       @id @default(autoincrement())
  description String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  projet      Projet?   @relation(fields: [projetId], references: [id], onDelete: SetNull)
  projetId    Int?

  tache       Tache?    @relation(fields: [tacheId], references: [id], onDelete: SetNull)
  tacheId     Int?
}